{
  "name": "dsh-plugin-sql-security-validate",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "AI SQL permission guard: intercepts out-of-permission SQL generated by Agents, refuses execution instead of rewriting it, and returns a structured permission reason.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "sql",
    "permission",
    "security",
    "chatbi"
  ],
  "icon": "icon.svg",
  "author": "huangzuting <641694064@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangzuting/dsh-plugin-sql-security-validate.git"
  },
  "homepage": "https://github.com/huangzuting/dsh-plugin-sql-security-validate#readme",
  "bugs": {
    "url": "https://github.com/huangzuting/dsh-plugin-sql-security-validate/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "src",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node tests/unit.mjs && node tests/report-vectors.mjs && node tests/subquery-vectors.mjs && node tests/qualification-vectors.mjs && node tests/engine.mjs && node tests/panel.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
