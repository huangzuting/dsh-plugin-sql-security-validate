# IMPORTANT: vendor/ must be committed, never ignored.
# src/sql-parse.js resolves the parser through
#   createRequire(import.meta.url)('../vendor/node-sql-parser/index.cjs')
# Ignoring it produces a clone that cannot start, loses offline installability,
# and removes the parser version from audit.
